# AceCoin Core testnet JSON-RPC
DAEMON_URL=http://CHANGE_ME_RPC_USER:CHANGE_ME_RPC_PASSWORD@acecoin-core:19332/

# ElectrumX
COIN=AceCoin
NET=testnet
DB_DIRECTORY=/data/electrumx
DB_ENGINE=rocksdb

# Local RPC is deliberately not published by docker-compose.
SERVICES=ssl://0.0.0.0:50002,rpc://127.0.0.1:8000
REPORT_SERVICES=ssl://electrum-testnet.example.org:50002

# TLS files inside the container
SSL_CERTFILE=/certs/server.crt
SSL_KEYFILE=/certs/server.key

LOG_LEVEL=info
